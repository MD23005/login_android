<?xml version="1.0" encoding="utf-8"?>
<!-- Layout principal del fragmento de perfil -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F5F5F5">

    <!-- Círculo azul que muestra la inicial del usuario -->
    <TextView
        android:id="@+id/txtAvatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="#2560f5"
        android:text="U"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Nombre completo del usuario -->
    <TextView
        android:id="@+id/txtPerfilNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre de usuario"
        android:textSize="20sp"
        android:textColor="#222222"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <!-- Email del usuario -->
    <TextView
        android:id="@+id/txtPerfilEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="correo@email.com"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="24dp"/>

    <!-- Línea separadora -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginBottom="16dp"/>

    <!-- Fila con etiqueta y valor del nombre de usuario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario: "
            android:textSize="14sp"
            android:textColor="#888888"/>
        <!-- Valor leído desde SharedPreferences -->
        <TextView
            android:id="@+id/txtPerfilUsuario2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Fila con etiqueta y valor del email -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: "
            android:textSize="14sp"
            android:textColor="#888888"/>
        <!-- Valor leído desde SharedPreferences -->
        <TextView
            android:id="@+id/txtPerfilEmail2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Botón para cerrar-->
    <Button
        android:id="@+id/btnSalirPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salir"
        android:backgroundTint="#d32f2f"
        android:textColor="#ffffff"
        android:layout_marginTop="8dp"/>

</LinearLayout>